#!/usr/bin/env bash
# FlowSight tool-neutral pre-commit guard.
#
# This runs the same shared commit-time checks no matter who staged the change.
# It remains bypassable by a human with direct Git access; protected-branch CI
# is the merge-time verification boundary.
#
# Enable once per clone with:  make init   (sets core.hooksPath=.githooks)
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
git_dir="$(git rev-parse --absolute-git-dir)"
git_index_file="$(git rev-parse --git-path index)"
if [[ "$git_index_file" != /* ]]; then
  git_index_file="$repo_root/$git_index_file"
fi
tmp_base="${TMPDIR:-/tmp}"
snapshot="$(mktemp -d "$tmp_base/flowsight-precommit.XXXXXX")"

cleanup() {
  chmod -R u+w "$snapshot" 2>/dev/null || true
  rm -rf -- "$snapshot"
}
trap cleanup EXIT

# Materialize exactly the index. Deleted files stay absent, rename destinations
# replace their sources, and unstaged working-tree rewrites cannot affect checks.
git checkout-index --all --prefix="$snapshot/"

if [[ -x "$repo_root/.venv/bin/python" ]]; then
  python_bin="$repo_root/.venv/bin/python"
else
  python_bin="$(command -v python3)"
fi

checker="$snapshot/scripts/agent/check_staged_files.py"
if [[ ! -f "$checker" ]]; then
  echo "[pre-commit] BLOCKED: index snapshot has no staged-file checker." >&2
  exit 1
fi

echo "[pre-commit] checking staged paths against the indexed active task"
if ! GIT_DIR="$git_dir" GIT_WORK_TREE="$snapshot" GIT_INDEX_FILE="$git_index_file" \
  PYTHONPATH= PYTHONNOUSERSITE=1 \
  "$python_bin" "$checker" --repo "$snapshot"; then
  echo "[pre-commit] BLOCKED: staged paths exceed the active task boundary." >&2
  exit 1
fi

# Give check-fast an isolated Git repository so its subprocess tests do not
# inherit the real repository's GIT_DIR/GIT_WORK_TREE. Add the snapshot before
# linking local dependency caches, keeping those caches outside validation.
(
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
  git -C "$snapshot" init -q
  git -C "$snapshot" add -f --all
)

if [[ -d "$repo_root/node_modules" && ! -e "$snapshot/node_modules" ]]; then
  ln -s "$repo_root/node_modules" "$snapshot/node_modules"
fi
if [[ -d "$repo_root/.venv" && ! -e "$snapshot/.venv" ]]; then
  ln -s "$repo_root/.venv" "$snapshot/.venv"
fi

echo "[pre-commit] running fast deterministic checks"
if ! (
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
  cd "$snapshot"
  PYTHONPATH= PYTHONNOUSERSITE=1 make check-fast PYTHON="$python_bin"
); then
  echo "[pre-commit] BLOCKED: 'make check-fast' failed. Fix the issues above before committing." >&2
  exit 1
fi

echo "[pre-commit] ok; full 'make check' remains required by CI/merge policy"
