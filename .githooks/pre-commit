#!/usr/bin/env bash
# FlowSight tool-neutral pre-commit guard.
#
# This runs the SAME shared checks no matter who staged the change:
# Claude Code, Codex, or a human. It is the load-bearing enforcement point,
# because neither agent can commit without passing through git.
#
# Enable once per clone with:  make init   (sets core.hooksPath=.githooks)
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[pre-commit] running: make check"
if ! make check; then
  echo "[pre-commit] BLOCKED: 'make check' failed. Fix the issues above before committing." >&2
  exit 1
fi
echo "[pre-commit] ok"
