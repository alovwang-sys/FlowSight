{
  "name": "flowsight-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "format": "./node_modules/.bin/prettier --write \"ui/**/*.{html,css,ts,tsx}\" \"package*.json\" \"tsconfig*.json\" eslint.config.js vite.config.ts .prettierrc.json",
    "format:check": "./node_modules/.bin/prettier --check \"ui/**/*.{html,css,ts,tsx}\" \"package*.json\" \"tsconfig*.json\" eslint.config.js vite.config.ts .prettierrc.json",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint ui/src vite.config.ts",
    "check": "npm run format:check && npm run typecheck && npm run lint",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "build:check": "npm run build && git diff --exit-code -- flowsight/static && test -z \"$(git ls-files --others --exclude-standard -- flowsight/static)\" && echo '[prototype-only] UI bundle/packaging evidence; no runtime phase gate is opened'"
  },
  "dependencies": {
    "@xyflow/react": "12.11.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  }
}
